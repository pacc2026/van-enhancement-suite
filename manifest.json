{
  "manifest_version": 3,
  "name": "VAN Enhancement Suite",
  "version": "0.3.3",
  "description": "Checkbox Targets picker, GOTV Turf Cutting mode, and precinct-based prefill for VAN's list building and turf cutting pages.",
  "icons": {
    "16": "src/icons/icon16.png",
    "32": "src/icons/icon32.png",
    "48": "src/icons/icon48.png",
    "128": "src/icons/icon128.png"
  },
  "update_url": "https://pacc2026.github.io/van-enhancement-suite/updates.xml",
  "key": "",
  "content_scripts": [
    {
      "matches": [
        "https://*.votebuilder.com/CreateAList.aspx*"
      ],
      "js": [
        "src/targets-checkboxes.js",
        "src/gotv-mode.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.votebuilder.com/CreateAList.aspx*"
      ],
      "css": [
        "src/targets-checkboxes.css",
        "src/gotv-mode.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.votebuilder.com/TurfCutter.aspx*"
      ],
      "js": [
        "src/precinct-map.js",
        "src/save-region.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
